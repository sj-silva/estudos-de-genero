<%- include('partials/head') %>
<div class="container py-5">
  <h1 class="display-5 fw-bold"><%= site.title %></h1>
  <p class="lead"><%= site.subtitle %></p>

  <ul class="list-unstyled mt-4">
  <% sections.forEach(s => { %>
    <li class="mb-2">
  <span class="d-inline-block fw-bold text-body-secondary text-end me-2" style="min-width: 1.8rem"><%= s.number %></span>
  <a href="/secao/<%= s.slug %>"><%= s.title %></a>
</li>
  <% }) %>
</ul>
</div>
<%- include('partials/foot') %>